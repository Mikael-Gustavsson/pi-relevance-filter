{
  "name": "pi-relevance-filter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pi extension: filter large tool results with the local Relevance Filter service (NPU, GPU or CPU; fail-open, reversible).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mikael-Gustavsson/pi-relevance-filter.git",
    "directory": "extension"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types ../tests/*.test.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "^22.0.0",
    "typebox": "*",
    "typescript": "^5.6.0"
  }
}
